<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <remove name="BOT Cotizacion SICETEC Y RDNC" />
                <rule name="cotizacionapp">
                    <match url="(.*)" />
                    <action type="Rewrite" url="http://127.0.0.1:8501/{R:1}" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
